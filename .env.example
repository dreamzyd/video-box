# ============================================================
# Video Box 1.1.0
# 复制为 .env 后使用。deploy.sh 会自动生成 APP_SECRET / APP_PASSWORD。
# ============================================================

# ===== 网络 =====
# 默认只监听服务器本机，更适合 SSH 隧道或宿主机 Nginx 反代。
BIND_ADDRESS=127.0.0.1
VIDEO_PORT=8080

# 若明确需要让服务器网卡直接监听端口，改为：
# BIND_ADDRESS=0.0.0.0

CLIENT_MAX_BODY_SIZE=5g
MAX_UPLOAD_GB=5

# ===== 构建下载镜像 =====
# 国内服务器默认使用阿里云镜像；海外服务器可改回官方源。
DEBIAN_MIRROR=http://mirrors.aliyun.com/debian
DEBIAN_SECURITY_MIRROR=http://mirrors.aliyun.com/debian-security
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/

# 官方源示例：
# DEBIAN_MIRROR=http://deb.debian.org/debian
# DEBIAN_SECURITY_MIRROR=http://deb.debian.org/debian-security
# PIP_INDEX_URL=https://pypi.org/simple

PYTHON_BASE_IMAGE=python:3.12-slim-bookworm
NGINX_IMAGE=nginx:alpine

# ===== 公开播放地址 / 二维码 =====
# 确定域名后推荐固定填写，例如：https://video.example.com
# 留空时，系统根据生成二维码时当前访问的域名 / IP / 端口生成播放地址。
PUBLIC_BASE_URL=

# ===== 视频转码 =====
# 转码成功后是否保留原始文件；小磁盘机器建议 false。
KEEP_ORIGINAL=false

# 2 核 2G 建议保持 1，避免多个线程长期占满 CPU。
FFMPEG_THREADS=1
VIDEO_CRF=24
VIDEO_PRESET=veryfast


# ===== 文档转换 / 手机阅读 =====
# 文档默认保留原文件，便于之后按需开启下载；2 核 2G 仍由单 Worker 串行处理。
KEEP_DOCUMENT_ORIGINAL=true
# PDF 页面渲染清晰度。120 DPI 在手机阅读与磁盘占用之间较均衡。
DOCUMENT_RENDER_DPI=120
DOCUMENT_JPEG_QUALITY=82

# ===== 登录 =====
# 上传页 + 管理中心共用此口令；公开视频 /v/xxxxx 无需登录。
# 留空时 deploy.sh 首次运行会自动生成。
APP_PASSWORD=

# 登录 Session 有效时间（小时）。
APP_SESSION_HOURS=12

# 直接 HTTP / SSH 隧道访问保持 false；外层已启用 HTTPS 后建议改为 true。
COOKIE_SECURE=false

# Flask Session Cookie 签名密钥，不是登录密码。
# 留空时 deploy.sh 首次运行会自动生成。修改后已有登录会话会全部失效。
APP_SECRET=
